# webapp の環境変数サンプル。値はコード上のデフォルト（ローカル開発向け）。
# 秘密情報は空にしてあるので、各自の値を設定する。

# --- 必須 ---
# DB 接続文字列（Prisma）
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA"
# next-auth の署名鍵。32byte の base64 文字列。匿名キー・入室アクセス Cookie の HMAC 鍵にも使用。
AUTH_SECRET=
# akashic-server (/start, /end, /join, /kick 等) 呼び出しの内部トークン
SERVER_WEBAPP_API_TOKEN=
# drain webhook の署名検証に使う共有鍵
HMAC_SECRET=
