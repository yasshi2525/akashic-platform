generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String            @id @default(cuid())
  name          String?
  handle        String?           @unique
  email         String?           @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  notices       Notification[]
  games         Game[]
  plays         Play[]
  fbPosts       FeedbackPost[]
  fbReplies     FeedbackReply[]
  clientLogs    ClientLogRecord[]
  favorites     Favorite[]
  boardMessages BoardMessage[]
  chatMessages  PlayChatMessage[]
  mutes         Mute[]            @relation("MuteOwner")
  mutedBy       Mute[]            @relation("MuteTarget")
  reports       Report[]
  contacts      ContactMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    String
  gameId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model Game {
  id          Int            @id @default(autoincrement())
  publisherId String
  title       String
  description String
  credit      String         @default("")
  streaming   Boolean        @default(true)
  playCount   Int            @default(0)
  versions    Content[]
  feedbacks   FeedbackPost[]
  favorites   Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publisher User @relation(fields: [publisherId], references: [id], onDelete: Cascade)
}

model Content {
  id     Int    @id @default(autoincrement())
  gameId Int
  icon   String
  plays  Play[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model Play {
  id            Int       @id @default(autoincrement())
  contentId     Int
  gameMasterId  String
  gmUserId      String?
  name          String
  isLimited     Boolean   @default(false)
  joinWord      String?
  inviteHash    String?
  requireSignIn Boolean   @default(false)
  chatEnabled   Boolean   @default(false)
  isActive      Boolean   @default(true)
  endedAt       DateTime?
  logUploadedAt DateTime?
  logDeletedAt  DateTime?
  crashed       Boolean   @default(false)
  errorLogged   Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content      Content           @relation(fields: [contentId], references: [id], onDelete: Cascade)
  gmUser       User?             @relation(fields: [gmUserId], references: [id], onDelete: Cascade)
  chatMessages PlayChatMessage[]
}

model FeedbackPost {
  id         Int            @id @default(autoincrement())
  gameId     Int
  authorId   String?
  authorName String
  body       String
  reply      FeedbackReply?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game   Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

model FeedbackReply {
  id       Int    @id @default(autoincrement())
  postId   Int    @unique
  authorId String
  body     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   FeedbackPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model BoardMessage {
  id         Int      @id @default(autoincrement())
  authorId   String?
  authorName String
  guestId    String?
  body       String
  createdAt  DateTime @default(now())

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([guestId, createdAt])
}

model PlayChatMessage {
  id         Int      @id @default(autoincrement())
  playId     Int
  authorId   String?
  authorName String
  guestId    String?
  body       String
  createdAt  DateTime @default(now())

  play   Play  @relation(fields: [playId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([playId, id])
  @@index([playId, authorId, createdAt])
  @@index([playId, guestId, createdAt])
}

/// ミュートは閲覧者ごとの見え方の設定であり、相手の権利は変えない。
/// 未サインイン利用者は端末内 (localStorage) に持つため、ここには現れない。
model Mute {
  id            Int     @id @default(autoincrement())
  ownerId       String
  /// 相手がサインイン利用者の場合のみ設定される
  targetUserId  String?
  /// 相手が未サインイン利用者の場合のみ設定される。相手が Cookie を消すと失効する
  targetGuestId String?
  /// 解除 UI で相手を判別するための手がかり。ゲストは表示名が自称のため、
  /// ミュートした時点の名前と本文の冒頭を控えておかないと一覧が読めない
  labelSnapshot String

  createdAt DateTime @default(now())

  owner      User  @relation("MuteOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetUser User? @relation("MuteTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([ownerId, targetUserId])
  @@unique([ownerId, targetGuestId])
  @@index([ownerId])
}

/// 利用者からの通報。管理 UI は設けず、psql と通報メールで捌く。
/// 対象の投稿・部屋・ユーザーは後から消えることがあるため、通報時点の
/// 内容を bodySnapshot に控え、証拠保全と後追い調査を可能にする。
model Report {
  id           Int              @id @default(autoincrement())
  targetType   ReportTargetType
  /// 対象の識別子。種別により int(メッセージ/部屋) と cuid(ユーザー) が
  /// 混在するため文字列で保持する
  targetId     String
  reason       ReportReason
  detail       String?
  /// 通報時点の対象内容の控え（投稿本文・部屋名・ユーザー名など）
  bodySnapshot String
  status       ReportStatus     @default(OPEN)

  reporterId      String?
  reporterGuestId String?

  createdAt DateTime @default(now())

  reporter User? @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

/// 運営者への自由記述の問い合わせ。返信は SES から個別に行う想定で、
/// 返信先メールは任意入力（サインイン済みでもメールは自動取得しない）。
model ContactMessage {
  id         Int           @id @default(autoincrement())
  name       String
  replyEmail String?
  body       String
  status     ContactStatus @default(OPEN)

  senderId      String?
  senderGuestId String?

  createdAt DateTime @default(now())

  sender User? @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model Notification {
  id      Int              @id @default(autoincrement())
  userId  String
  unread  Boolean
  type    NotificationType
  iconURL String?
  body    String
  link    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ClientLogRecord {
  id          Int      @id @default(autoincrement())
  playId      Int
  contentId   Int
  clientId    String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  comment     String?
  submittedAt DateTime @default(now())

  createdAt DateTime @default(now())
}

enum NotificationType {
  FEEDBACKED
  FEEDBACK_REPLIED
  GAME_CRASHED
  GAME_ERROR_LOGGED
  CLIENT_LOG_SUBMITTED
}

enum ReportTargetType {
  BOARD_MESSAGE
  PLAY_CHAT_MESSAGE
  PLAY
  USER
}

enum ReportReason {
  HARASSMENT
  INAPPROPRIATE
  PRIVACY
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  ACTIONED
  REJECTED
}

enum ContactStatus {
  OPEN
  IN_PROGRESS
  DONE
}
